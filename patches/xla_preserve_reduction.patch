+#include <string>
+#include <tuple>
+#include <utility>
+
+#include "absl/strings/str_cat.h"
+#include "xla/backends/cpu/ynn_support.h"
+#include "xla/hlo/testlib/hlo_hardware_independent_test_base.h"
+#include "gtest/gtest.h"
+
+namespace xla::cpu {
+namespace {
+
+class YnnReductionRetentionTest
+    : public HloHardwareIndependentTestBase,
+      public ::testing::WithParamInterface<std::tuple<int, std::string>> {};
+
+TEST_P(YnnReductionRetentionTest, ReductionPreferenceAcrossSizeThreshold) {
+  const auto& [size, retention] = GetParam();
+  const std::string attr = retention.empty()
+      ? "" : absl::StrCat(", frontend_attributes={xla_preserve_reduction=\"",
+                           retention, "\"}");
+  for (const std::string& operation : {"reduce", "reduce-window", "dot"}) {
+    SCOPED_TRACE(operation);
+    std::string root;
+    if (operation == "reduce") {
+      root = "ROOT result = f32[] reduce(input, initial), dimensions={0}, to_apply=add";
+    } else if (operation == "reduce-window") {
+      root = absl::StrCat("ROOT result = f32[", size - 1,
+          "] reduce-window(input, initial), window={size=2}, to_apply=add");
+    } else {
+      root = "ROOT result = f32[] dot(input, input), lhs_contracting_dims={0}, rhs_contracting_dims={0}";
+    }
+    auto module_or = ParseAndReturnVerifiedModule(absl::StrCat(R"hlo(
+HloModule retention
+add {
+  lhs = f32[] parameter(0)
+  rhs = f32[] parameter(1)
+  ROOT sum = f32[] add(lhs, rhs)
+}
+ENTRY main {
+  input = f32[)hlo", size, R"hlo(] parameter(0)
+  initial = f32[] constant(0)
+  )hlo", root, attr, "\n}\n"));
+    ASSERT_TRUE(module_or.ok()) << module_or.status();
+    auto module = std::move(module_or).value();
+    const bool expected = retention != "true" &&
+                          (operation == "dot" || size >= 4096);
+    EXPECT_EQ(IsInstructionPreferredByYnn(
+                  module->entry_computation()->root_instruction()), expected);
+  }
+}
+
+TEST_F(YnnReductionRetentionTest, OtherOperationsKeepSizePreference) {
+  auto module_or = ParseAndReturnVerifiedModule(R"hlo(
+HloModule other
+ENTRY main {
+  input = f32[4096] parameter(0)
+  ROOT result = f32[4096] negate(input), frontend_attributes={xla_preserve_reduction="true"}
+}
+)hlo");
+  ASSERT_TRUE(module_or.ok()) << module_or.status();
+  auto module = std::move(module_or).value();
+  EXPECT_TRUE(IsInstructionPreferredByYnn(
+      module->entry_computation()->root_instruction()));
+}
+
+INSTANTIATE_TEST_SUITE_P(
+    SizeAndAttribute, YnnReductionRetentionTest,
+    ::testing::Combine(::testing::Values(4095, 4096, 4097),
+                       ::testing::Values("", "false", "true")));
+
+}  // namespace
