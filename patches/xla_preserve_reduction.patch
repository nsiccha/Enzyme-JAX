diff --git a/xla/hlo/transforms/simplifiers/tree_reduction_retention_test.cc b/xla/hlo/transforms/simplifiers/tree_reduction_retention_test.cc
new file mode 100644
--- /dev/null
+++ b/xla/hlo/transforms/simplifiers/tree_reduction_retention_test.cc
@@ -0,0 +1,105 @@
+#include <utility>
+
+#include "xla/hlo/transforms/simplifiers/tree_reduction_rewriter.h"
+
+#include "xla/hlo/ir/hlo_opcode.h"
+#include "xla/hlo/testlib/hlo_hardware_independent_test_base.h"
+#include "gtest/gtest.h"
+
+namespace xla {
+namespace {
+
+class TreeReductionRetentionTest : public HloHardwareIndependentTestBase {};
+
+TEST_F(TreeReductionRetentionTest, PreservesMarkedReduction) {
+  auto module_or = ParseAndReturnVerifiedModule(R"hlo(HloModule reduction
+
+add {
+  lhs = f64[] parameter(0)
+  rhs = f64[] parameter(1)
+  ROOT sum = f64[] add(lhs, rhs)
+}
+
+ENTRY main {
+  input = f64[2048] parameter(0)
+  initial = f64[] constant(0)
+  ROOT result = f64[] reduce(input, initial), dimensions={0}, to_apply=add, frontend_attributes={xla_preserve_reduction="true"}
+}
+)hlo");
+  ASSERT_TRUE(module_or.ok()) << module_or.status();
+  auto module = std::move(module_or).value();
+  TreeReductionRewriter pass;
+  for (int iteration = 0; iteration < 2; ++iteration) {
+    auto changed = pass.Run(module.get());
+    ASSERT_TRUE(changed.ok()) << changed.status();
+    EXPECT_FALSE(changed.value());
+  }
+  int windows = 0;
+  for (const auto* instruction : module->entry_computation()->instructions()) {
+    windows += instruction->opcode() == HloOpcode::kReduceWindow;
+  }
+  EXPECT_EQ(windows, 0);
+}
+
+TEST_F(TreeReductionRetentionTest, OptimizesUnmarkedReduction) {
+  auto module_or = ParseAndReturnVerifiedModule(R"hlo(HloModule reduction
+
+add {
+  lhs = f64[] parameter(0)
+  rhs = f64[] parameter(1)
+  ROOT sum = f64[] add(lhs, rhs)
+}
+
+ENTRY main {
+  input = f64[2048] parameter(0)
+  initial = f64[] constant(0)
+  ROOT result = f64[] reduce(input, initial), dimensions={0}, to_apply=add
+}
+)hlo");
+  ASSERT_TRUE(module_or.ok()) << module_or.status();
+  auto module = std::move(module_or).value();
+  TreeReductionRewriter pass;
+  for (int iteration = 0; iteration < 2; ++iteration) {
+    auto changed = pass.Run(module.get());
+    ASSERT_TRUE(changed.ok()) << changed.status();
+    EXPECT_TRUE(changed.value());
+  }
+  int windows = 0;
+  for (const auto* instruction : module->entry_computation()->instructions()) {
+    windows += instruction->opcode() == HloOpcode::kReduceWindow;
+  }
+  EXPECT_EQ(windows, 2);
+}
+
