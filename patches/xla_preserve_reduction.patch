+++ b/xla/hlo/transforms/simplifiers/tree_reduction_rewriter.cc
@@ -46,6 +46,14 @@
 
   absl::Status HandleReduce(HloInstruction* hlo) override {
     if (filter_ && !filter_(hlo)) {
+      return absl::OkStatus();
+    }
+
+    // A frontend may require one reduction region independent of its data
+    // dimensions. Repeated tree rewriting otherwise adds a region per level.
+    const auto& attrs = hlo->frontend_attributes().map();
+    auto preserve = attrs.find("xla_preserve_reduction");
+    if (preserve != attrs.end() && preserve->second == "true") {
       return absl::OkStatus();
     }
 
