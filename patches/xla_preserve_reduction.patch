+  auto module = std::move(module_or).value();
+  TreeReductionRewriter pass;
+  for (int iteration = 0; iteration < 2; ++iteration) {
+    auto changed = pass.Run(module.get());
+    ASSERT_TRUE(changed.ok()) << changed.status();
+    EXPECT_TRUE(changed.value());
+  }
+  int windows = 0;
+  for (const auto* instruction : module->entry_computation()->instructions()) {
+    windows += instruction->opcode() == HloOpcode::kReduceWindow;
+  }
+  EXPECT_EQ(windows, 2);
+}
