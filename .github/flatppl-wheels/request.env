# The FlatPPL enzyme_ad candidate that a push of this branch builds wheels for.
#
# The release RELEASE_TAG must already exist on this repository as a pre-release whose tag
# points at SOURCE_SHA, and the BUILD file at SOURCE_SHA must set version VERSION. The
# workflow builds every PYTHONS x PLATFORMS wheel that the release does not carry yet,
# tests each one on its own runner, and uploads the ones that pass. It never replaces a
# wheel that is already there. To build another candidate, push a commit that edits these
# values.

SOURCE_SHA=06e07e5b78ef18176330dd3ccbf867d61a374fc1
VERSION=0.0.15+flatppl.23.adaptivewhile.boolrange.eigh.enzymedialect.batchedreverse.nestedwhile.boundedtape.1
RELEASE_TAG=flatppl-alpha.23-adaptivewhile.boolrange.eigh.enzymedialect.batchedreverse.nestedwhile.boundedtape.1

# The flatppl-alpha.23 matrix that flatppl-python declares.
PYTHONS="3.12 3.13 3.14 3.15"
PLATFORMS="manylinux_2_28_x86_64 manylinux_2_28_aarch64 macosx_14_0_arm64"

# Test files from the candidate's test/ directory that each installed wheel must pass,
# besides smoke.py's own reverse-mode checks.
TESTS="test_eigh_composite test_det_composite test_logabsdet_composite test_solve_composite test_hlo_batching test_hlo_linalg_batching test_hlo_linalg_lowering test_hlo_enzyme_dialect"
